<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_page_bg"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <!-- Broadcast listener -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardListener"
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/headerListener"
                    style="@style/SectionHeader">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Listener"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/app_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:text="Broadcast listener" />

                        <TextView
                            android:id="@+id/listenerStatus"
                            style="@style/SectionSubtitle"
                            android:text="Stopped · catch broadcasts other apps send" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/listenerChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Expand"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/app_on_surface_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listenerBody"
                    style="@style/SectionBody"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Actions to listen for (one per line or comma)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listenerActionsInput"
                            style="@style/AppCodeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:maxLines="5"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Data scheme (optional)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/listenerSchemeInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Result code (ordered)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/listenerResultCodeInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberSigned"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Result data (ordered, optional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/listenerResultDataInput"
                            style="@style/AppEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/listenerExportedSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:checked="true"
                        android:text="Accept broadcasts from other apps (exported)"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/listenerAbortSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Abort ordered broadcasts after receiving"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/listenerToggleButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:text="Start listening"
                        app:icon="@drawable/ic_play" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Receiver activity info -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReceiverInfo"
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Receiver"
                        android:src="@drawable/ic_inbox"
                        app:tint="@color/app_primary" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Intenter as a target" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Point the app under test at this exported activity. Every intent it receives is dumped here with the caller's identity, and you can return a custom result."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/app_on_surface_variant" />

                <TextView
                    android:id="@+id/receiverComponentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_code_panel"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="com.open.intenter/.ReceiverActivity\nintenter://…  ·  ACTION_SEND */*"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/app_code_text"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyReceiverComponentButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Copy component"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyReceiverAdbButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Copy adb example"
                        app:icon="@drawable/ic_terminal"
                        app:iconSize="18dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/eventsTitle"
                style="@style/SectionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Events" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearEventsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Clear"
                app:icon="@drawable/ic_delete"
                app:iconSize="18dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/eventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="28dp"
            android:text="Nothing yet.\nLaunches, results, received intents and caught broadcasts show up here."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/app_on_surface_variant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eventsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
