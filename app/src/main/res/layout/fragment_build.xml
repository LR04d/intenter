<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buildRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_page_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="150dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- ── Target ─────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardComponent"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerComponent"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Target" />

                            <TextView
                                android:id="@+id/summaryComponent"
                                style="@style/SectionSubtitle"
                                android:text="Package and class for explicit intents" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useComponent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/componentLayout"
                        style="@style/SectionBody">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPackage"
                                style="@style/AppTextInputLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Package name"
                                app:endIconMode="clear_text"
                                app:startIconDrawable="@drawable/ic_package">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/packageInput"
                                    style="@style/AppEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="textNoSuggestions"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/browsePackageButton"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginTop="2dp"
                                android:minWidth="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="16dp"
                                android:text="Browse"
                                app:icon="@drawable/ic_apps"
                                app:iconSize="18dp" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilComponent"
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Component class (optional)"
                            app:endIconMode="clear_text"
                            app:helperText="Empty targets the package only. A leading dot is expanded."
                            app:startIconDrawable="@drawable/ic_class">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/componentInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/componentInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_status_pill"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/app_on_surface_variant"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_shield"
                            app:drawableTint="@color/app_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Actions ────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAction"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerAction"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Action" />

                            <TextView
                                android:id="@+id/summaryAction"
                                style="@style/SectionSubtitle"
                                android:text="Standard or custom action; several run in sequence" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useActions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionsLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/actionsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addActionButton"
                            style="@style/AddRowButton"
                            android:layout_marginTop="8dp"
                            android:text="Add action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Data ───────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardData"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerData"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Data and MIME type" />

                            <TextView
                                android:id="@+id/summaryData"
                                style="@style/SectionSubtitle"
                                android:text="URI and/or MIME type for the receiver" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dataLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/schemeChips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipSpacingHorizontal="6dp"
                                app:singleLine="true" />
                        </HorizontalScrollView>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Data URI"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dataUriInput"
                                style="@style/AppCodeEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textUri|textMultiLine"
                                android:maxLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayoutDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="MIME type (optional)">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/dataTypeInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Categories ─────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCategory"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerCategory"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Categories" />

                            <TextView
                                android:id="@+id/summaryCategory"
                                style="@style/SectionSubtitle"
                                android:text="Standard or custom category constants" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoriesLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/categoriesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addCategoryButton"
                            style="@style/AddRowButton"
                            android:layout_marginTop="8dp"
                            android:text="Add category" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Extras ─────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExtras"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerExtras"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Extras" />

                            <TextView
                                android:id="@+id/summaryExtras"
                                style="@style/SectionSubtitle"
                                android:text="Typed key–value payload, nested bundles, intents, arrays" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useExtras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/extrasLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/extrasContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/addExtraButton"
                                style="@style/AddRowButton"
                                android:text="Add extra" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/extrasFromJsonButton"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                android:text="From JSON"
                                app:icon="@drawable/ic_data_object"
                                app:iconSize="18dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ClipData ───────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClipData"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerClipData"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="ClipData" />

                            <TextView
                                android:id="@+id/summaryClipData"
                                style="@style/SectionSubtitle"
                                android:text="Attach text, HTML, URIs or intents (use grant flags for URIs)" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useClipData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/clipDataLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/AppTextInputLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Label"
                                app:endIconMode="clear_text">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/clipDataLabelInput"
                                    style="@style/AppEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="text"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/AppTextInputLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:hint="MIME types (comma)"
                                app:endIconMode="clear_text">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/clipDataMimeTypesInput"
                                    style="@style/AppEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext"
                                    android:inputType="text"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/clipDataItemsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addClipDataItemButton"
                            style="@style/AddRowButton"
                            android:layout_marginTop="8dp"
                            android:text="Add clip item" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Flags ──────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFlags"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerFlags"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Flags" />

                            <TextView
                                android:id="@+id/summaryFlags"
                                style="@style/SectionSubtitle"
                                android:text="Task, URI grant and receiver flags, plus raw values" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useFlags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/flagsLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/flagsGroupsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/flagsChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Raw flags (0x10000000, 268435456, comma or | separated)"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/customFlagsInput"
                                style="@style/AppCodeEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/flagsEffective"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/app_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Options ────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOptions"
                style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerChooser"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Chooser dialog" />

                            <TextView
                                android:id="@+id/summaryChooser"
                                style="@style/SectionSubtitle"
                                android:text="Wrap in Intent.createChooser (activity modes)" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useChooser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chooserLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Chooser title (optional)"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chooserTitleInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/app_outline_variant" />

                    <LinearLayout
                        android:id="@+id/headerAdvanced"
                        style="@style/SectionHeader">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SectionTitle"
                                android:text="Advanced" />

                            <TextView
                                android:id="@+id/summaryAdvanced"
                                style="@style/SectionSubtitle"
                                android:text="Receiver permission, intent identifier" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/useAdvanced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advancedLayout"
                        style="@style/SectionBody"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Receiver permission (broadcasts)"
                            app:endIconMode="clear_text"
                            app:helperText="Only receivers holding this permission get the broadcast">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/receiverPermissionInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Identifier (Intent.setIdentifier, API 29+)"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/identifierInput"
                                style="@style/AppEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Preview / launch sheet ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="140dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/sheetPeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_drag_handle" />

            <TextView
                android:id="@+id/previewLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="intent:#Intent;end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/app_on_surface" />

            <TextView
                android:id="@+id/resolveLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Handlers: …"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/app_on_surface_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:text="Activity"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="end"
                    app:iconPadding="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/launchButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/launch_intent"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/app_outline_variant" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/formatChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFmtUri"
                        style="@style/RowChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Intent URI" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFmtAdb"
                        style="@style/RowChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="adb shell am" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFmtJava"
                        style="@style/RowChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Java" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFmtKotlin"
                        style="@style/RowChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kotlin" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFmtJson"
                        style="@style/RowChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JSON" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_code_panel">

                <TextView
                    android:id="@+id/intentPreviewText"
                    style="@style/CodePanel"
                    android:background="@null"
                    android:text="intent:#Intent;end" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyIntentButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Copy"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareIntentButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:text="Share"
                    app:icon="@drawable/ic_share"
                    app:iconSize="18dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bindingsButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="1 bound"
                    android:visibility="gone"
                    app:icon="@drawable/ic_link"
                    app:iconSize="18dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Handlers on this device"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/app_on_surface" />

            <TextView
                android:id="@+id/handlersText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="…"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/app_on_surface_variant"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
